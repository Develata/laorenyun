# Local Compose. Never commit .env. Native DSH launch link/cookie protects access.
LAORENYUN_PROFILE=laorenyun
LAORENYUN_PORT=3080
LAORENYUN_PROBES=false
# DSH pi-ai route; one of openai-responses / openai-completions / anthropic-messages.
# Exact model is deployment-owned. Leave empty only for offline/probe testing.
LAORENYUN_LLM_PROTOCOL=openai-responses
LAORENYUN_LLM_MODEL=
LAORENYUN_LLM_BASE_URL=https://api.openai.com/v1
LAORENYUN_LLM_API_KEY=
# Optional selection of a provider already configured in native DSH settings.
LAORENYUN_MODEL_PROVIDER=deepseek-official
LAORENYUN_MODEL=deepseek-flash
# Tencent credentials stay in Host env, never browser/domain SQLite.
TENCENTCLOUD_APP_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh_en
TENCENT_ASR_TIMEOUT_MS=90000
TENCENT_TTS_VOICE=101001
TENCENT_TTS_SPEED=-0.5
TENCENT_TTS_VOLUME=0
TENCENT_TTS_TIMEOUT_MS=60000
# TTS codec is intentionally MP3: sequential short chunks share one playback.
# No region required by selected Flash/TextToVoice endpoints.
