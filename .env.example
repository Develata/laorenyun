# Docker Compose owns the container data path; never commit .env.
LAORENYUN_PROFILE=laorenyun
LAORENYUN_PORT=3080
# Deterministic paid-call-free probes require BOTH dev profile and true.
LAORENYUN_PROBES=false
# Select a provider already configured in native DSH settings (Phase 2).
LAORENYUN_MODEL_PROVIDER=deepseek-official
LAORENYUN_MODEL=deepseek-flash
# Reserved Phase 2 credential adapter names; not consumed by Phase 1.
LAORENYUN_LLM_PROTOCOL=openai-responses
LAORENYUN_LLM_MODEL=
LAORENYUN_LLM_BASE_URL=
LAORENYUN_LLM_API_KEY=
# Reserved for Phase 2. Unused by Phase 1; no Tencent request is made.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_APP_ID=
TENCENTCLOUD_REGION=ap-shanghai
LAORENYUN_ASR_ENGINE=16k_zh_en
LAORENYUN_TTS_VOICE=1001
# Reserved logging adapter; native DSH logging currently applies.
LAORENYUN_LOG_LEVEL=warn
# Access uses the native DSH launch link and persistent signed cookie.
# No second password, public agent endpoint, or embedded credential.
